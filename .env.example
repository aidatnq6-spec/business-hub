# Copy to .env.local and supply the existing Business Hub Firebase Web config.
# These Firebase Web values are public client configuration, not Admin credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Never put Telegram, OpenRouter, or service-account secrets in NEXT_PUBLIC_*.

# Server-only Telegram report configuration (Vercel Production environment).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# At least 32 random characters. Vercel sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
TELEGRAM_REPORT_ENABLED=false
FIREBASE_PROJECT_ID=
# Optional: if omitted, the Admin SDK resolves the existing owner by email.
FIREBASE_OWNER_UID=
# JSON service account, stored only in the server environment. Never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative on Google infrastructure: explicitly opt into Application Default Credentials.
FIREBASE_USE_ADC=false

# Marketing: server-only. Keep all flags off until costs/configuration are approved.
MARKETING_ENABLED=false
MARKETING_GENERATION_ENABLED=false
MARKETING_SCHEDULE_ENABLED=false
MARKETING_TELEGRAM_ENABLED=false
MARKETING_GEMINI_KEY=
MARKETING_TEXT_MODEL=gemini-3.1-flash-lite
MARKETING_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Review current prices, taxes and model access before setting a future expiry date.
MARKETING_PRICES_VALID_UNTIL=
# Exact vi-VN Neural2 voice must be listed, listened to and approved first.
MARKETING_TTS_VOICE=
MARKETING_TTS_VOICE_APPROVED=false
MARKETING_BUCKET=
MARKETING_QUEUE=
MARKETING_WORKER_URL=
MARKETING_TASK_SA=
MARKETING_SCHEDULER_SA=
MARKETING_PREPARE_JOB=
MARKETING_NOTIFY_JOB=
MARKETING_ORIGIN=

# AI settings: server-only encryption master key (32 random bytes, base64).
# Same value is needed on the API server and worker; never prefix NEXT_PUBLIC.
AI_SETTINGS_ENCRYPTION_KEY=
# Exact trusted application origin for settings mutations (no path/trailing slash).
AI_SETTINGS_ORIGIN=
# Leave off until metadata-only check billing has been reviewed.
AI_SETTINGS_METADATA_CHECK_VERIFIED=false
# Separate deployment approval gate; saving a key never changes this.
AI_SETTINGS_ACTIVATION_APPROVED=false
