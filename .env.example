# Copy to .env.local and supply the existing Business Hub Firebase Web config.
# These Firebase Web values are public client configuration, not Admin credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Never put Telegram, OpenRouter, or service-account secrets in NEXT_PUBLIC_*.

# Server-only Telegram report configuration (Vercel Production environment).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# At least 32 random characters. Vercel sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
TELEGRAM_REPORT_ENABLED=false
FIREBASE_PROJECT_ID=
# Optional: if omitted, the Admin SDK resolves the existing owner by email.
FIREBASE_OWNER_UID=
# JSON service account, stored only in the server environment. Never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative on Google infrastructure: explicitly opt into Application Default Credentials.
FIREBASE_USE_ADC=false
